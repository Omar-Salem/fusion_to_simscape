			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<!-- Spherical Joint ComplexType -->
	<xs:complexType name = "sphericalJointType">
		<xs:annotation>
			<xs:documentation>This complex type is used to define a spherical joint between two instances.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base = "smi:jointType">
