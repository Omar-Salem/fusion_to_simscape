			<xs:enumeration value="lbm"/>
			<xs:enumeration value="slug"/>
			<xs:enumeration value="ounce"/>
			<xs:enumeration value="oz"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Entity type enumeration -->
	<xs:simpleType name="entityTypeEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Part"/>
			<xs:enumeration value="Assembly"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Geometry type enumerations -->
	<xs:simpleType name="geometryTypeEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="plane"/>
			<xs:enumeration value="cylinder"/>
			<xs:enumeration value="cone"/>
