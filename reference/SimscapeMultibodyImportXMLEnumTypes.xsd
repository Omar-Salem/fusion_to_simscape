<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:smi="urn:mathworks:SimscapeMultibody:import" targetNamespace="urn:mathworks:SimscapeMultibody:import" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<!-- Coordinate frame type enumerations -->
	<xs:simpleType name="frameTypeEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="PARENT"/>
			<xs:enumeration value="Parent"/>
			<xs:enumeration value="parent"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Length unit type enumeration -->
	<xs:simpleType name="lengthUnitTypeEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="kilometer"/>
			<xs:enumeration value="km"/>
			<xs:enumeration value="meter"/>
			<xs:enumeration value="m"/>
			<xs:enumeration value="centimeter"/>
			<xs:enumeration value="cm"/>
			<xs:enumeration value="millimeter"/>
			<xs:enumeration value="mm"/>
			<xs:enumeration value="micrometer"/>
			<xs:enumeration value="um"/>
			<xs:enumeration value="inch"/>
			<xs:enumeration value="in"/>
			<xs:enumeration value="foot"/>
			<xs:enumeration value="ft"/>
			<xs:enumeration value="yard"/>
			<xs:enumeration value="yd"/>
			<xs:enumeration value="mile"/>
			<xs:enumeration value="mi"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Mass unit type enumeration -->
	<xs:simpleType name="massUnitTypeEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="kilogram"/>
			<xs:enumeration value="kg"/>
			<xs:enumeration value="gram"/>
