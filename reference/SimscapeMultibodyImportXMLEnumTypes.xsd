			<xs:enumeration value="circulararc"/>
			<xs:enumeration value="ellipse"/>
			<xs:enumeration value="ellipticalarc"/>
			<xs:enumeration value="point"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Model file type enumeration -->
	<xs:simpleType name="modelFileTypeEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="ProEngineer Part"/>
			<xs:enumeration value="ProEngineer Assembly"/>
			<xs:enumeration value="SolidWorks Assembly"/>
			<xs:enumeration value="SolidWorks Part"/>
			<xs:enumeration value="Inventor Assembly"/>
			<xs:enumeration value="Inventor Part"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Geometry file type enumeration -->
	<xs:simpleType name="geometryFileTypeEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="STL"/>
			<xs:enumeration value="stl"/>
			<xs:enumeration value="STEP"/>
			<xs:enumeration value="step"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
